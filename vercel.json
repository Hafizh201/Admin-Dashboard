{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "public",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin/",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path+/",
      "destination": "/admin/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
